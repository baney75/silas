{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silas",
  "version": "0.1.1",
  "identifier": "com.baney.silas",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Silas",
        "url": "index.html",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "overlay",
        "title": "Silas Overlay",
        "url": "overlay.html",
        "width": 260,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Hold a key, speak, and Silas types it.",
    "longDescription": "Silas is a private, on-device dictation app. Hold a key, speak, release, and it types what you said into any app. It learns your words as you correct it.",
    "copyright": "© 2026 Donovan Baney",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-silas-input.rules": "linux/70-silas-input.rules"
        },
        "postInstallScript": "linux/postinst.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-silas-input.rules": "linux/70-silas-input.rules"
        },
        "postInstallScript": "linux/postinst.sh"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1QTkyOTlGNzM0MEJGMTIKUldRU3YwQnpueW1wMVUvOEtteWFXL0xyUys3L1JOSmhZbkFqNEtUVTh5RjdwWGZMdWV1VzA4cGcK",
      "endpoints": [
        "https://github.com/baney75/silas/releases/download/nightly/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
