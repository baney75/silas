{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silas-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  // Daily, just after UTC midnight: forget client HMACs older than yesterday even with no POST.
  "triggers": { "crons": ["5 0 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "silas-registry",
      // The Personal account's database, made by `wrangler d1 create silas-registry` (README, deploy step 2).
      "database_id": "2ad7b9d1-1a09-4cca-a593-5342695b08af",
      "migrations_dir": "migrations"
    }
  ]
  // RATE_KEY is a secret: `wrangler secret put RATE_KEY`. Never put it here.
}
